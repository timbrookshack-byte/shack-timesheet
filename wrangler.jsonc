{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shack-timesheet",
  "main": "./src/index.ts",
  "compatibility_date": "2025-04-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timesheet",
      "database_id": "8fc253c5-a6cf-4b1b-b8b3-6f6434c33c19",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SUMMARY_TO": "sgreen@thefurnitureshack.com.au",
    "EMAIL_FROM": "The Furniture Shack Timesheets <timesheets@thefurnitureshack.com.au>",
    "MANAGER_NAME": "Alex"
  },
  // Monday 5:00am Australia/Brisbane (UTC+10, no daylight saving) = Sunday 19:00 UTC.
  "triggers": { "crons": ["0 19 * * SUN"] }
}
